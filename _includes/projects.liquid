<div class="col mb-4">
    <article class="card project-card h-100 hoverable">
      {% if project.img %}
        <a class="project-card-media" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" {% if project.redirect contains '://' %}target="_blank" rel="noopener"{% endif %}>
          <img src="{{ project.img | relative_url }}" alt="{{ project.image_alt | default: project.title }}" class="card-img-top" loading="lazy">
        </a>
      {% else %}
        <a class="project-card-media project-card-media--type" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" {% if project.redirect contains '://' %}target="_blank" rel="noopener"{% endif %} aria-label="Open {{ project.title }}">
          <span>{{ project.short | default: project.title }}</span>
        </a>
      {% endif %}
      <div class="card-body">
        <p class="project-meta">{{ project.year }}{% if project.venue %} · {{ project.venue }}{% endif %}</p>
        <h2 class="card-title"><a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" {% if project.redirect contains '://' %}target="_blank" rel="noopener"{% endif %}>{{ project.title }}</a></h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.highlight %}<p class="project-highlight">{{ project.highlight }}</p>{% endif %}
        {% if project.tags %}<p class="project-tags">{{ project.tags | join: " · " }}</p>{% endif %}
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </article>
</div>
